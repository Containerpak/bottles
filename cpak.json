{
  "manifest_version": "1.0",
  "name": "Bottles",
  "description": "Run and manage your Windows applications on Linux with Wine and Proton.",
  "version": "65.4",
  "image": "ghcr.io/containerpak/bottles:main",
  "binaries": ["/usr/bin/bottles"],
  "desktop_entries": ["/usr/share/applications/com.usebottles.bottles.desktop"],
  "dependencies": [
    {
      "Id": "",
      "Origin": "github.com/containerpak/umu",
      "Branch": "",
      "Release": "",
      "Commit": ""
    }
  ],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketX11": true,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSessionBus": true,
    "socketSystemBus": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "socketAtSpiBus": false,
    "socketBluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": true,
    "notification": true,
    "fsHost": false,
    "fsHostEtc": false,
    "fsHostHome": true,
    "fsExtra": [],
    "env": [
      "LANG=C.UTF-8",
      "LC_ALL=C.UTF-8",
      "PATH=/app/bin:/usr/bin:/usr/local/bin:/usr/lib/extensions/vulkan/MangoHud/bin/:/usr/lib/extensions/vulkan/OBSVkCapture/bin/:/usr/lib/extensions/vulkan/gamescope/bin/",
      "LD_LIBRARY_PATH=/app/lib:/app/lib/i386-linux-gnu:/usr/lib",
      "GST_PLUGIN_SYSTEM_PATH=/app/lib/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/gstreamer-1.0:/usr/lib/i386-linux-gnu/gstreamer-1.0"
    ],
    "network": true,
    "process": false,
    "asRoot": false,
    "allowedHostCommands": []
  }
}
